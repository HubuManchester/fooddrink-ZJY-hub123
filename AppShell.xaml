<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="FoodDrinkMaui.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:FoodDrinkMaui"
    xmlns:pages="clr-namespace:FoodDrinkMaui.Pages"
    Shell.FlyoutBehavior="Disabled">

    <TabBar>
        <ShellContent
            Title="Home"
            ContentTemplate="{DataTemplate local:MainPage}"
            Route="MainPage" />

        <ShellContent
            Title="Camera"
            ContentTemplate="{DataTemplate pages:CameraPage}"
            Route="CameraPage" />

        <ShellContent
            Title="Location"
            ContentTemplate="{DataTemplate pages:LocationPage}"
            Route="LocationPage" />

        <ShellContent
            Title="Settings"
            ContentTemplate="{DataTemplate pages:SettingsPage}"
            Route="SettingsPage" />
    </TabBar>

</Shell>
