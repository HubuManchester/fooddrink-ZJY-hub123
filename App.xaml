<?xml version = "1.0" encoding = "UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FoodDrinkMaui.App">
    <Application.Resources>
        <ResourceDictionary>
            <Color x:Key="Primary">#FF6B35</Color>
            <Color x:Key="Secondary">#2E4057</Color>
            <Color x:Key="Accent">#4CAF50</Color>
            <Color x:Key="Background">#FAFAFA</Color>
            <Color x:Key="Surface">#FFFFFF</Color>
            <Color x:Key="TextPrimary">#1A1A1A</Color>
            <Color x:Key="TextSecondary">#666666</Color>

            <Style TargetType="Button" x:Key="PrimaryButton">
                <Setter Property="BackgroundColor" Value="{StaticResource Primary}"/>
                <Setter Property="TextColor" Value="White"/>
                <Setter Property="FontAttributes" Value="Bold"/>
                <Setter Property="CornerRadius" Value="12"/>
                <Setter Property="Padding" Value="20,14"/>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
