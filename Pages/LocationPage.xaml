<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FoodDrinkMaui.Pages.LocationPage"
             BackgroundColor="{StaticResource Background}"
             Title="Nearby Restaurants">

    <ScrollView>
        <VerticalStackLayout Spacing="0">

            <!-- Header Banner -->
            <Frame BackgroundColor="#2196F3"
                   CornerRadius="0"
                   Padding="24,36,24,28"
                   HasShadow="False">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Nearby Restaurants"
                           FontSize="28"
                           FontAttributes="Bold"
                           TextColor="White"/>
                    <Label Text="Discover great food places around you"
                           FontSize="14"
                           TextColor="#FFFFFFCC"/>
                </VerticalStackLayout>
            </Frame>

            <VerticalStackLayout Padding="20,24" Spacing="20">

                <!-- Location Status Card -->
                <Frame BackgroundColor="{StaticResource Surface}"
                       CornerRadius="18"
                       Padding="20"
                       HasShadow="True"
                       BorderColor="{StaticResource Divider}">
                    <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="14">
                        <Frame Grid.Column="0"
                               BackgroundColor="{StaticResource TagBlue}"
                               CornerRadius="14"
                               Padding="14"
                               HasShadow="False"
                               WidthRequest="52"
                               HeightRequest="52">
                            <Label Text="&#x1F4CD;"
                                   FontSize="22"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"/>
                        </Frame>
                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="3">
                            <Label Text="Your Location"
                                   FontSize="15"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource TextPrimary}"/>
                            <Label x:Name="LocationLabel"
                                   Text="Tap to detect your location"
                                   FontSize="13"
                                   TextColor="{StaticResource TextSecondary}"/>
                        </VerticalStackLayout>
                        <Button Grid.Column="2"
                                Text="Detect"
                                Style="{StaticResource PrimaryButton}"
                                Padding="14,10"
                                VerticalOptions="Center"
                                Clicked="OnGetLocationClicked"/>
                    </Grid>
                </Frame>

                <!-- Filter Chips -->
                <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                    <HorizontalStackLayout Spacing="10" Padding="2,4">
                        <Frame BackgroundColor="{StaticResource Primary}" CornerRadius="20" Padding="14,8" HasShadow="False">
                            <Label Text="All" FontSize="13" FontAttributes="Bold" TextColor="White"/>
                        </Frame>
                        <Frame BackgroundColor="{StaticResource Surface}" CornerRadius="20" Padding="14,8" HasShadow="False" BorderColor="{StaticResource Divider}">
                            <Label Text="Chinese" FontSize="13" TextColor="{StaticResource TextSecondary}"/>
                        </Frame>
                        <Frame BackgroundColor="{StaticResource Surface}" CornerRadius="20" Padding="14,8" HasShadow="False" BorderColor="{StaticResource Divider}">
                            <Label Text="Japanese" FontSize="13" TextColor="{StaticResource TextSecondary}"/>
                        </Frame>
                        <Frame BackgroundColor="{StaticResource Surface}" CornerRadius="20" Padding="14,8" HasShadow="False" BorderColor="{StaticResource Divider}">
                            <Label Text="Italian" FontSize="13" TextColor="{StaticResource TextSecondary}"/>
                        </Frame>
                        <Frame BackgroundColor="{StaticResource Surface}" CornerRadius="20" Padding="14,8" HasShadow="False" BorderColor="{StaticResource Divider}">
                            <Label Text="Fast Food" FontSize="13" TextColor="{StaticResource TextSecondary}"/>
                        </Frame>
                    </HorizontalStackLayout>
                </ScrollView>

                <!-- Section Title -->
                <Label Text="Restaurants Near You"
                       Style="{StaticResource SectionHeader}"/>

                <!-- Restaurant 1 -->
                <Frame Style="{StaticResource Card}">
                    <Grid ColumnDefinitions="80, *, Auto" Padding="16" ColumnSpacing="14">
                        <Frame Grid.Column="0"
                               BackgroundColor="#FFECB3"
                               CornerRadius="14"
                               Padding="0"
                               HasShadow="False"
                               HeightRequest="72"
                               WidthRequest="72">
                            <Label Text="&#x1F409;"
                                   FontSize="36"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"/>
                        </Frame>
                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="5">
                            <Label Text="Golden Dragon Restaurant"
                                   FontSize="15"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource TextPrimary}"/>
                            <Label Text="Chinese Cuisine"
                                   FontSize="12"
                                   TextColor="{StaticResource TextSecondary}"/>
                            <HorizontalStackLayout Spacing="12">
                                <HorizontalStackLayout Spacing="3">
                                    <Label Text="&#x2B50;" FontSize="12" TextColor="#FFC107"/>
                                    <Label Text="4.5" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}"/>
                                </HorizontalStackLayout>
                                <Label Text="0.5 km away" FontSize="12" TextColor="{StaticResource TextSecondary}"/>
                            </HorizontalStackLayout>
                            <Frame BackgroundColor="{StaticResource TagGreen}" CornerRadius="6" Padding="8,3" HasShadow="False" HorizontalOptions="Start">
                                <Label Text="Open Now" FontSize="10" FontAttributes="Bold" TextColor="{StaticResource TagGreenText}"/>
                            </Frame>
                        </VerticalStackLayout>
                        <Label Grid.Column="2"
                               Text=">"
                               FontSize="18"
                               TextColor="{StaticResource TextSecondary}"
                               VerticalOptions="Center"/>
                    </Grid>
                </Frame>

                <!-- Restaurant 2 -->
                <Frame Style="{StaticResource Card}">
                    <Grid ColumnDefinitions="80, *, Auto" Padding="16" ColumnSpacing="14">
                        <Frame Grid.Column="0"
                               BackgroundColor="#E1F5FE"
                               CornerRadius="14"
                               Padding="0"
                               HasShadow="False"
                               HeightRequest="72"
                               WidthRequest="72">
                            <Label Text="&#x1F363;"
                                   FontSize="36"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"/>
                        </Frame>
                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="5">
                            <Label Text="Sakura Sushi Bar"
                                   FontSize="15"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource TextPrimary}"/>
                            <Label Text="Japanese Cuisine"
                                   FontSize="12"
                                   TextColor="{StaticResource TextSecondary}"/>
                            <HorizontalStackLayout Spacing="12">
                                <HorizontalStackLayout Spacing="3">
                                    <Label Text="&#x2B50;" FontSize="12" TextColor="#FFC107"/>
                                    <Label Text="4.8" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}"/>
                                </HorizontalStackLayout>
                                <Label Text="0.8 km away" FontSize="12" TextColor="{StaticResource TextSecondary}"/>
                            </HorizontalStackLayout>
                            <Frame BackgroundColor="{StaticResource TagGreen}" CornerRadius="6" Padding="8,3" HasShadow="False" HorizontalOptions="Start">
                                <Label Text="Open Now" FontSize="10" FontAttributes="Bold" TextColor="{StaticResource TagGreenText}"/>
                            </Frame>
                        </VerticalStackLayout>
                        <Label Grid.Column="2"
                               Text=">"
                               FontSize="18"
                               TextColor="{StaticResource TextSecondary}"
                               VerticalOptions="Center"/>
                    </Grid>
                </Frame>

                <!-- Restaurant 3 -->
                <Frame Style="{StaticResource Card}">
                    <Grid ColumnDefinitions="80, *, Auto" Padding="16" ColumnSpacing="14">
                        <Frame Grid.Column="0"
                               BackgroundColor="#FCE4EC"
                               CornerRadius="14"
                               Padding="0"
                               HasShadow="False"
                               HeightRequest="72"
                               WidthRequest="72">
                            <Label Text="&#x1F355;"
                                   FontSize="36"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"/>
                        </Frame>
                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="5">
                            <Label Text="Pizza Paradise"
                                   FontSize="15"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource TextPrimary}"/>
                            <Label Text="Italian Cuisine"
                                   FontSize="12"
                                   TextColor="{StaticResource TextSecondary}"/>
                            <HorizontalStackLayout Spacing="12">
                                <HorizontalStackLayout Spacing="3">
                                    <Label Text="&#x2B50;" FontSize="12" TextColor="#FFC107"/>
                                    <Label Text="4.3" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}"/>
                                </HorizontalStackLayout>
                                <Label Text="1.2 km away" FontSize="12" TextColor="{StaticResource TextSecondary}"/>
                            </HorizontalStackLayout>
                            <Frame BackgroundColor="{StaticResource TagOrange}" CornerRadius="6" Padding="8,3" HasShadow="False" HorizontalOptions="Start">
                                <Label Text="Closes at 10PM" FontSize="10" FontAttributes="Bold" TextColor="{StaticResource TagOrangeText}"/>
                            </Frame>
                        </VerticalStackLayout>
                        <Label Grid.Column="2"
                               Text=">"
                               FontSize="18"
                               TextColor="{StaticResource TextSecondary}"
                               VerticalOptions="Center"/>
                    </Grid>
                </Frame>

                <!-- Restaurant 4 -->
                <Frame Style="{StaticResource Card}">
                    <Grid ColumnDefinitions="80, *, Auto" Padding="16" ColumnSpacing="14">
                        <Frame Grid.Column="0"
                               BackgroundColor="#F3E5F5"
                               CornerRadius="14"
                               Padding="0"
                               HasShadow="False"
                               HeightRequest="72"
                               WidthRequest="72">
                            <Label Text="&#x1F354;"
                                   FontSize="36"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"/>
                        </Frame>
                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="5">
                            <Label Text="Burger Palace"
                                   FontSize="15"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource TextPrimary}"/>
                            <Label Text="American Fast Food"
                                   FontSize="12"
                                   TextColor="{StaticResource TextSecondary}"/>
                            <HorizontalStackLayout Spacing="12">
                                <HorizontalStackLayout Spacing="3">
                                    <Label Text="&#x2B50;" FontSize="12" TextColor="#FFC107"/>
                                    <Label Text="4.6" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}"/>
                                </HorizontalStackLayout>
                                <Label Text="1.5 km away" FontSize="12" TextColor="{StaticResource TextSecondary}"/>
                            </HorizontalStackLayout>
                            <Frame BackgroundColor="{StaticResource TagGreen}" CornerRadius="6" Padding="8,3" HasShadow="False" HorizontalOptions="Start">
                                <Label Text="Open 24h" FontSize="10" FontAttributes="Bold" TextColor="{StaticResource TagGreenText}"/>
                            </Frame>
                        </VerticalStackLayout>
                        <Label Grid.Column="2"
                               Text=">"
                               FontSize="18"
                               TextColor="{StaticResource TextSecondary}"
                               VerticalOptions="Center"/>
                    </Grid>
                </Frame>

            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
