<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FoodDrinkMaui.Pages.LocationPage"
             BackgroundColor="{StaticResource Background}"
             Title="Nearby Restaurants">

    <CollectionView x:Name="RestaurantsCollection"
                    SelectionMode="None">

        <!-- Header -->
        <CollectionView.Header>
            <VerticalStackLayout Spacing="0">
                <Frame BackgroundColor="#2196F3"
                       CornerRadius="0" Padding="24,36,24,28" HasShadow="False">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Nearby Restaurants"
                               FontSize="28" FontAttributes="Bold" TextColor="White"/>
                        <Label Text="Discover great food places around you"
                               FontSize="14" TextColor="#FFFFFFCC"/>
                    </VerticalStackLayout>
                </Frame>

                <VerticalStackLayout Padding="20,24,20,0" Spacing="20">

                    <!-- Location Status Card -->
                    <Frame BackgroundColor="{StaticResource Surface}"
                           CornerRadius="18" Padding="20" HasShadow="True"
                           BorderColor="{StaticResource Divider}">
                        <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="14">
                            <Frame Grid.Column="0"
                                   BackgroundColor="{StaticResource TagBlue}"
                                   CornerRadius="14" Padding="14" HasShadow="False"
                                   WidthRequest="52" HeightRequest="52">
                                <Label Text="📍" FontSize="22"
                                       HorizontalOptions="Center" VerticalOptions="Center"/>
                            </Frame>
                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="3">
                                <Label Text="Your Location"
                                       FontSize="15" FontAttributes="Bold"
                                       TextColor="{StaticResource TextPrimary}"/>
                                <Label x:Name="LocationLabel"
                                       Text="Tap to detect your location"
                                       FontSize="13" TextColor="{StaticResource TextSecondary}"/>
                            </VerticalStackLayout>
                            <Button Grid.Column="2"
                                    Text="Detect"
                                    Style="{StaticResource PrimaryButton}"
                                    Padding="14,10" VerticalOptions="Center"
                                    Clicked="OnGetLocationClicked"
                                    AutomationId="DetectLocationBtn"
                                    SemanticProperties.Description="Detect your current GPS location"/>
                        </Grid>
                    </Frame>

                    <Label Text="Restaurants Near You"
                           Style="{StaticResource SectionHeader}"/>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </CollectionView.Header>

        <!-- Footer spacing -->
        <CollectionView.Footer>
            <BoxView HeightRequest="20" Color="Transparent"/>
        </CollectionView.Footer>

        <!-- Single Restaurant Card Template — replaces 4 hardcoded copies -->
        <CollectionView.ItemTemplate>
            <DataTemplate>
                <Frame Style="{StaticResource Card}" Margin="20,8"
                       AutomationId="{Binding Name}"
                       SemanticProperties.Description="{Binding Name}">
                    <Frame.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnRestaurantClicked"
                                              CommandParameter="{Binding .}"/>
                    </Frame.GestureRecognizers>
                    <Grid ColumnDefinitions="80, *, Auto" Padding="16" ColumnSpacing="14">
                        <!-- Icon -->
                        <Frame Grid.Column="0"
                               BackgroundColor="{Binding ColorHex}"
                               CornerRadius="14" Padding="0" HasShadow="False"
                               HeightRequest="72" WidthRequest="72">
                            <Label Text="{Binding Emoji}" FontSize="36"
                                   HorizontalOptions="Center" VerticalOptions="Center"/>
                        </Frame>

                        <!-- Info -->
                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="5">
                            <Label Text="{Binding Name}"
                                   FontSize="15" FontAttributes="Bold"
                                   TextColor="{StaticResource TextPrimary}"/>
                            <Label Text="{Binding Cuisine}"
                                   FontSize="12" TextColor="{StaticResource TextSecondary}"/>
                            <HorizontalStackLayout Spacing="12">
                                <HorizontalStackLayout Spacing="3">
                                    <Label Text="⭐" FontSize="12" TextColor="#FFC107"/>
                                    <Label Text="{Binding Rating}"
                                           FontSize="12" FontAttributes="Bold"
                                           TextColor="{StaticResource TextPrimary}"/>
                                </HorizontalStackLayout>
                                <Label Text="{Binding Distance}"
                                       FontSize="12" TextColor="{StaticResource TextSecondary}"/>
                            </HorizontalStackLayout>

                            <!-- Status badge — defaults orange, green for Open -->
                            <Frame CornerRadius="6" Padding="8,3" HasShadow="False"
                                   HorizontalOptions="Start"
                                   BackgroundColor="{StaticResource TagOrange}">
                                <Frame.Triggers>
                                    <DataTrigger TargetType="Frame"
                                                 Binding="{Binding Status}"
                                                 Value="Open Now">
                                        <Setter Property="BackgroundColor" Value="{StaticResource TagGreen}"/>
                                    </DataTrigger>
                                    <DataTrigger TargetType="Frame"
                                                 Binding="{Binding Status}"
                                                 Value="Open 24h">
                                        <Setter Property="BackgroundColor" Value="{StaticResource TagGreen}"/>
                                    </DataTrigger>
                                </Frame.Triggers>
                                <Label Text="{Binding Status}"
                                       FontSize="10" FontAttributes="Bold"
                                       TextColor="{StaticResource TagOrangeText}">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label"
                                                     Binding="{Binding Status}"
                                                     Value="Open Now">
                                            <Setter Property="TextColor" Value="{StaticResource TagGreenText}"/>
                                        </DataTrigger>
                                        <DataTrigger TargetType="Label"
                                                     Binding="{Binding Status}"
                                                     Value="Open 24h">
                                            <Setter Property="TextColor" Value="{StaticResource TagGreenText}"/>
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                            </Frame>
                        </VerticalStackLayout>

                        <!-- Arrow -->
                        <Label Grid.Column="2" Text="›" FontSize="22"
                               TextColor="{StaticResource TextSecondary}"
                               VerticalOptions="Center"/>
                    </Grid>
                </Frame>
            </DataTemplate>
        </CollectionView.ItemTemplate>

    </CollectionView>
</ContentPage>
