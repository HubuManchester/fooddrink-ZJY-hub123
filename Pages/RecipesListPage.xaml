<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FoodDrinkMaui.Pages.RecipesListPage"
             BackgroundColor="{StaticResource Background}"
             Title="All Recipes">

    <CollectionView x:Name="RecipesCollection"
                    SelectionMode="None">

        <!-- Header -->
        <CollectionView.Header>
            <VerticalStackLayout Spacing="0">
                <Frame BackgroundColor="{StaticResource Primary}"
                       CornerRadius="0" Padding="24,36,24,28" HasShadow="False">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="All Recipes" FontSize="28" FontAttributes="Bold" TextColor="White"/>
                        <Label Text="Browse 1,200+ delicious recipes from around the world"
                               FontSize="14" TextColor="#FFFFFFCC"/>
                    </VerticalStackLayout>
                </Frame>

                <!-- Category Filter -->
                <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never" Margin="0,16,0,0">
                    <HorizontalStackLayout x:Name="FilterBar" Spacing="10" Padding="20,0">
                        <!-- Filter chips built in code-behind -->
                    </HorizontalStackLayout>
                </ScrollView>
            </VerticalStackLayout>
        </CollectionView.Header>

        <!-- Footer -->
        <CollectionView.Footer>
            <Button Text="Load More Recipes"
                    Style="{StaticResource SecondaryButton}"
                    Clicked="OnLoadMoreClicked"
                    HorizontalOptions="Fill"
                    Margin="20,8,20,24"
                    AutomationId="LoadMoreBtn"
                    SemanticProperties.Description="Load additional recipes"/>
        </CollectionView.Footer>

        <!-- Single Item Template — replaces 5 hardcoded Frame blocks -->
        <CollectionView.ItemTemplate>
            <DataTemplate>
                <Frame BackgroundColor="{StaticResource Surface}"
                       CornerRadius="16" Padding="16" HasShadow="True"
                       Margin="20,8"
                       AutomationId="{Binding Name}"
                       SemanticProperties.Description="{Binding Name}">
                    <Frame.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnRecipeClicked"
                                              CommandParameter="{Binding Name}"/>
                    </Frame.GestureRecognizers>
                    <Grid ColumnDefinitions="80, *" ColumnSpacing="16">
                        <Frame Grid.Column="0"
                               BackgroundColor="{Binding ColorHex}"
                               CornerRadius="12" Padding="0"
                               HeightRequest="80" HasShadow="False">
                            <Label Text="{Binding Emoji}"
                                   FontSize="40"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"/>
                        </Frame>
                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="6">
                            <Label Text="{Binding Name}"
                                   FontSize="17" FontAttributes="Bold"
                                   TextColor="{StaticResource TextPrimary}"/>
                            <HorizontalStackLayout Spacing="12">
                                <Label Text="{Binding Time}"
                                       FontSize="13" TextColor="{StaticResource TextSecondary}"/>
                                <Label Text="{Binding Category}"
                                       FontSize="13" TextColor="{StaticResource Accent}"/>
                            </HorizontalStackLayout>
                            <HorizontalStackLayout Spacing="4">
                                <Label Text="{Binding Rating}"
                                       FontSize="13" FontAttributes="Bold"
                                       TextColor="{StaticResource Primary}"/>
                                <Label Text="{Binding Reviews}"
                                       FontSize="12" TextColor="{StaticResource TextSecondary}"/>
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </Grid>
                </Frame>
            </DataTemplate>
        </CollectionView.ItemTemplate>

    </CollectionView>
</ContentPage>
