<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FoodDrinkMaui.Pages.CameraPage"
             BackgroundColor="{StaticResource Background}"
             Title="Scan Food">

    <VerticalStackLayout Padding="20" Spacing="20" VerticalOptions="Center">

        <Frame BackgroundColor="{StaticResource Surface}"
               CornerRadius="16"
               Padding="40"
               BorderColor="#E0E0E0"
               HasShadow="True"
               HorizontalOptions="Center">
            <VerticalStackLayout Spacing="20" HorizontalOptions="Center">
                <Label Text="Camera"
                       FontSize="64"
                       HorizontalOptions="Center"/>
                <Label Text="Scan ingredients with your camera"
                       FontSize="16"
                       TextColor="{StaticResource TextSecondary}"
                       HorizontalOptions="Center"/>
            </VerticalStackLayout>
        </Frame>

        <Image x:Name="CapturedImage"
               HeightRequest="200"
               Aspect="AspectFit"
               IsVisible="False"/>

        <Button Text="Take Photo"
                Style="{StaticResource PrimaryButton}"
                Clicked="OnTakePhotoClicked"
                HorizontalOptions="Center"/>

        <Button Text="Pick from Gallery"
                BackgroundColor="{StaticResource Secondary}"
                TextColor="White"
                CornerRadius="12"
                Padding="20,14"
                Clicked="OnPickPhotoClicked"
                HorizontalOptions="Center"/>

        <Label x:Name="ResultLabel"
               Text=""
               FontSize="16"
               TextColor="{StaticResource TextPrimary}"
               HorizontalOptions="Center"/>

    </VerticalStackLayout>
</ContentPage>
